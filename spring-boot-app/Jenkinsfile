pipeline {
    agent {
        docker {
            image 'jibin321/maven-docker-agent:v2'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Starting Checkout...'
                sh 'pwd'
                sh 'ls -la'
            }
        }

        stage('Build and Test') {
            steps {
                echo 'Building Spring Boot application...'

                sh '''
                    set -e
                    cd spring-boot-app
                    echo "Current directory:"
                    pwd
                    echo "Files:"
                    ls -la

                    echo "Running Maven build..."
                    mvn clean package
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo 'Running SonarQube analysis...'

                withSonarQubeEnv('sonarqube') {
                    sh '''
                        set -e

                        cd spring-boot-app

                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.1.0.4751:sonar \
                          -Dsonar.projectKey=my-ec2-project \
                          -Dsonar.projectName="Spring Boot App" \
                          -Dsonar.host.url=$SONAR_HOST_URL
                    '''
                }
            }
        }

        stage('Build and Push Docker Image') {
            environment {
                DOCKER_IMAGE = "arjunsurya27/spring-boot-app:${BUILD_NUMBER}"
            }

            steps {
                script {

                    echo "Building Docker image: ${DOCKER_IMAGE}"

                    sh '''
                        cd spring-boot-app

                        docker --version

                        docker build \
                          -t ${DOCKER_IMAGE} .
                    '''

                    echo "Pushing Docker image..."

                    def dockerImage = docker.image("${DOCKER_IMAGE}")

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-cred'
                    ) {
                        dockerImage.push()
                        dockerImage.push('latest')
                    }
                }
            }
        }

        stage('Update Deployment File') {
            environment {
                GIT_REPO_NAME = "java-maven-sonar-argocd"
                GIT_USER_NAME = "arjunsurya9955"
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-id',
                        usernameVariable: 'GITHUB_USERNAME',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "Checking workspace..."
                        pwd
                        ls -la

                        echo "Checking deployment file..."
                        ls -la spring-boot-app-manifests/

                        git config user.email "arjunsurya027@gmail.com"
                        git config user.name "${GIT_USER_NAME}"

                        echo "Updating Kubernetes image..."

                        sed -i "s|image: .*|image: arjunsurya27/spring-boot-app:${BUILD_NUMBER}|g" \
                        spring-boot-app-manifests/deployment.yml

                        echo "Updated deployment:"
                        cat spring-boot-app-manifests/deployment.yml

                        git add spring-boot-app-manifests/deployment.yml

                        git commit \
                          -m "Update spring-boot image tag to ${BUILD_NUMBER} [skip ci]" \
                          || echo "No changes to commit"

                        echo "Pushing changes to GitHub..."

                        git push \
                          https://${GITHUB_USERNAME}:${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git \
                          HEAD:main
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the stage and command above this message.'
        }
    }
}
